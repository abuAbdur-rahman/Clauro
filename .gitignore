# Build output
target/
node_modules/
dist/
*.exe
*.msi
src-tauri/gen/

# Local machine specifics -- D88 says these never belong in the spec
docs/dev-host.md

# Generated reports and research artefacts
.agents/

# Secrets. Never committed, never staged: keys live in the OS keychain at
# runtime and in .env files on dev machines only. The keychain test asserts
# no key material reaches any other sink; this line keeps the dev fallback
# out of git even if someone runs `git add .` on autopilot.
.env
.env.*

# Harness scratch
.openchamber/

# Task 001 throwaway spike apps. Not production code -- to be deleted once the
# verdict is written (Tasks/001 acceptance). The verdict is the deliverable,
# not the app that produced it. Anchored to root so docs/spikes/ (where verdicts
# live) stays tracked.
/spikes/
